diff --git a/packages/ffi/test/koffi-binding.mjs b/packages/ffi/test/koffi-binding.mjs
new file mode 100644
index 0000000..c805871
--- /dev/null
+++ b/packages/ffi/test/koffi-binding.mjs
@@ -0,0 +1,27 @@
+// Installs the `echo_*` globals the emitted dist/esm/internal/ffi.js calls,
+// backed by the shared build (build/libcutils_ffi_echo.so) through koffi.
+// Span ABI: bytes/mutable-bytes cross as (ptr,len) pairs.
+
+import koffi from "koffi";
+import { fileURLToPath } from "node:url";
+import path from "node:path";
+
+const dir = path.dirname(fileURLToPath(import.meta.url));
+const lib = koffi.load(path.join(dir, "..", "build", "libcutils_ffi_echo.so"));
+
+const g = globalThis;
+
+const f = {
+  size: lib.func("int32 echo_size()"),
+  i32: lib.func("int32 echo_i32(int32 value)"),
+  i64: lib.func("int64 echo_i64(int64 value)"),
+  point: lib.func(
+    "int32 echo_point(const uint8_t *in_ptr, uint64 in_len, uint8_t *out_ptr, uint64 out_len)",
+  ),
+};
+
+g.echo_size = () => f.size();
+g.echo_i32 = (value) => f.i32(value);
+g.echo_i64 = (value) => f.i64(value);
+g.echo_point = (input, output) =>
+  f.point(input, BigInt(input.length), output, BigInt(output.length));
diff --git a/packages/ffi/test/wrapper.test.js b/packages/ffi/test/wrapper.test.js
