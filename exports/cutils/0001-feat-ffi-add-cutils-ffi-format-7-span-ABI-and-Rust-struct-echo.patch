diff --git a/packages/ffi/src/layout.ts b/packages/ffi/src/layout.ts
new file mode 100644
index 0000000..6244ace
--- /dev/null
+++ b/packages/ffi/src/layout.ts
@@ -0,0 +1,43 @@
+// Little-endian field accessors for `#[repr(C)]` structs on LE hosts.
+// scriptc format 7 does not marshal structs: callers pack into `bytes` /
+// `mutable-bytes` with these helpers, matching native layout.
+
+export function writeI32(buf: Uint8Array, offset: number, value: number): void {
+  buf[offset] = value & 0xff;
+  buf[offset + 1] = (value >> 8) & 0xff;
+  buf[offset + 2] = (value >> 16) & 0xff;
+  buf[offset + 3] = (value >> 24) & 0xff;
+}
+
+export function readI32(buf: Uint8Array, offset: number): number {
+  return buf[offset] | (buf[offset + 1] << 8) | (buf[offset + 2] << 16) | (buf[offset + 3] << 24);
+}
+
+export function writeU32(buf: Uint8Array, offset: number, value: number): void {
+  writeI32(buf, offset, value);
+}
+
+export function readU32(buf: Uint8Array, offset: number): number {
+  return readI32(buf, offset) >>> 0;
+}
+
+export function writeI64(buf: Uint8Array, offset: number, value: bigint): void {
+  let v = value;
+  const mask = BigInt(255);
+  const eight = BigInt(8);
+  for (let i = 0; i < 8; i++) {
+    buf[offset + i] = Number(v & mask);
+    v = v >> eight;
+  }
+}
+
+export function readI64(buf: Uint8Array, offset: number): bigint {
+  let v = BigInt(0);
+  const eight = BigInt(8);
+  for (let i = 7; i >= 0; i--) {
+    v = (v << eight) | BigInt(buf[offset + i]);
+  }
+  const bits = BigInt(64);
+  const sign = BigInt(1) << (bits - BigInt(1));
+  return (v ^ sign) - sign;
+}
diff --git a/packages/ffi/src/spec.ts b/packages/ffi/src/spec.ts
new file mode 100644
index 0000000..cd098f8
--- /dev/null
+++ b/packages/ffi/src/spec.ts
@@ -0,0 +1,37 @@
+// Shared scriptc FFI manifest types. `ffi_format: 7` is the ABI
+// `@cutils/sqlite` already ships (span strings/bytes, pointer-as-bigint).
+// Downstream shims (pty, keyring, this package's echo crate) must match.
+
+export const FFI_FORMAT = 7;
+
+export type FfiScalar =
+  | "bool"
+  | "f32"
+  | "f64"
+  | "i8"
+  | "i16"
+  | "i32"
+  | "i64"
+  | "pointer"
+  | "u8"
+  | "u16"
+  | "u32"
+  | "u64";
+
+export type FfiSpan = "bytes" | "mutable-bytes" | "string";
+
+export type FfiType = FfiScalar | FfiSpan | "void";
+
+export interface FfiFunctionDecl {
+  name: string;
+  symbol: string;
+  params: FfiType[];
+  returns: FfiType;
+}
+
+export interface FfiManifest {
+  ffi_format: 7;
+  functions: FfiFunctionDecl[];
+  libraries: string[];
+  system_libraries: string[];
+}
