+        markerValue(checker.getTypeOfSymbol(prop), seen),
+    );
   };
   let primitive: IrType | null = null;
   let markerParts = 0;
@@ -8111,22 +8157,7 @@ function mapBrandedPrimitiveIntersection(widened: ts.Type, ctx: TypeMapperCtx):
       primitive = mappedPrimitive;
       continue;
     }
