     if (
       value.flags &
       (ts.TypeFlags.StringLiteral |
@@ -8092,15 +8096,57 @@ function mapBrandedPrimitiveIntersection(widened: ts.Type, ctx: TypeMapperCtx):
     ) {
       return true;
     }
-    if (value.isUnionType()) return ts.constituentTypes(value).every(markerValue);
